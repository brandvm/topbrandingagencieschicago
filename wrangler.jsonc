{
  "name": "topbrandingagencieschicago-staging",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "REVIEW_SCOPE": "main"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "topbrandingagencieschicago-review",
      "database_id": "f4725927-fbac-4e95-977d-379e7a62869b",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "ce645e22953cc9c203c64fe0f2bada66"
}
